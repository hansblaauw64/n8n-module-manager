{
  "manifest_version": 3,
  "name": "things.io Modules",
  "version": "0.4.0",
  "description": "Publiceer of unpubliceer n8n-workflows per module (tag mod:<naam>) vanuit het zijpaneel.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://things.io/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "brand/icon-16.png",
    "32": "brand/icon-32.png",
    "48": "brand/icon-48.png",
    "128": "brand/icon-128.png"
  },
  "action": {
    "default_title": "things.io Modules",
    "default_icon": {
      "16": "brand/icon-16.png",
      "32": "brand/icon-32.png"
    }
  },
  "short_name": "Modules"
}
